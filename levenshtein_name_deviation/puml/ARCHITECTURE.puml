@startuml
skinparam classAttributeIconSize 0
hide circle
hide empty members
skinparam linetype ortho
skinparam packageStyle rectangle

!include https://raw.githubusercontent.com/patrik-csak/one-dark-plantuml-theme/v1.0.1/theme.puml

title Levenshtein Name Deviation Pattern - Architecture Overview

package "Test Framework\n(de.tum.cit.aet)" as AET {

    package "levenshtein" <<Core Framework>> #2C3E50 {
        class Wrapper<T> <<abstract>> {
            Fuzzy name matching
            Existence verification
            Type checking
        }

        class ClassWrapper<T> <<abstract>> {
            Class structure verification
            ByteBuddy integration
            Member discovery
        }

        class AttributeWrapper
        class MethodWrapper
        class ConstructorWrapper
        class GenericClassWrapper

        class WrapperProperty {
            Expected vs Actual tracking
            Existence states
        }

        class StructuralLevenshtein {
            Test factory methods
            Structural assertions
        }

        class Utils {
            Levenshtein distance
            Type compatibility checks
        }
    }

    package "wrappers" <<Test Implementation>> #27AE60 {
        class DrivableWrapper {
            Tests Driveable interface
        }

        class AbstrWrapper {
            Tests AbstractVehicle
        }

        class CarWrapper {
            Tests Car class
        }
    }

    package "test" <<JUnit Tests>> #F39C12 {
        class TestManager {
            @TestFactory methods
            Structural tests
            Behavioral tests
        }
    }
}

package "Student Submission\n(de.tum.cit.aet)" as Sub #E74C3C {
    interface Driveable {
        MAX_SPEED
        start()
        getSpeed()
    }

    abstract class AbstractVehicle {
        manufacturer
        year
        calculateCost()
    }

    class Car {
        price
        speed
    }

    Car --|> AbstractVehicle
    Car ..|> Driveable
}

' Relationships between packages
DrivableWrapper ..> Driveable : verifies
AbstrWrapper ..> AbstractVehicle : verifies
CarWrapper ..> Car : verifies

DrivableWrapper --|> ClassWrapper
AbstrWrapper --|> ClassWrapper
CarWrapper --|> ClassWrapper

TestManager ..> CarWrapper : uses
TestManager ..> AbstrWrapper : uses
TestManager ..> DrivableWrapper : uses

TestManager ..> StructuralLevenshtein : generates tests

ClassWrapper --|> Wrapper
AttributeWrapper --|> Wrapper
MethodWrapper --|> Wrapper
ConstructorWrapper --|> Wrapper

Wrapper *-- WrapperProperty

note right of StructuralLevenshtein
    Generates JUnit DynamicTests
    with configurable detail levels:
    • ONE_FOR_EVERYTHING
    • ONE_PER_CLASS
    • ONE_PER_MEMBER_CATEGORY
end note

note right of ClassWrapper
    Uses ByteBuddy for:
    • Testing abstract classes
    • Dynamic subclass creation
    • Private member access fallback
end note

note bottom of "Sub"
    Student code may have:
    • Typos in names
    • Minor structural deviations
    • Different modifiers

    Pattern handles these gracefully
    using Levenshtein distance!
end note

@enduml

