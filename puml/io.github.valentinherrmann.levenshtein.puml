@startuml
skinparam classAttributeIconSize 0
hide circle
skinparam linetype ortho
hide empty members

!include https://raw.githubusercontent.com/patrik-csak/one-dark-plantuml-theme/v1.0.1/theme.puml

package "io.github.valentinherrmann.levenshtein" as LEV {

    class WrapperProperty<T> {
        ~expected: T
        ~actual: T
        ~existence: Existence
        --
        +WrapperProperty(expected: T)
        +toString(): String
        ..
        <<enum>> Existence
        UNCHECKED
        EXACT
        DEVIATES
        MISSING
    }

    abstract class Wrapper<T> {
        #name: WrapperProperty<String>
        #modifiers: WrapperProperty<String>
        #existence: Existence
        -parentClassWrapper: ClassWrapper<T>
        --
        +Wrapper(parentClass, expectedName, expectedModifiers)
        +verifyExistence(throwAssertion: boolean)
        +getOverallExistence(): Existence
        +getParentClassWrapper(): ClassWrapper<T>
        +getExpectedName(): String
        --
        #{abstract} findWithDeviation()
        #{abstract} parseExistence()
        +{abstract} expectedToString(): String
        +{abstract} actualToString(): String
        --
        #verifyModifiers(modifierBitmask: int)
        #verifyType(typeWrapperProperty, actualType)
    }

    abstract class ClassWrapper<T> {
        -expectedPackage: String
        -clazz: Class<T>
        #obj: T
        ~superClassWrapper: WrapperProperty<ClassWrapper<?>>
        ~interfaceWrappers: WrapperProperty<ClassWrapper<?>[]>
        --
        +ClassWrapper(expectedName, expectedPackage, ...)
        +getClazz(): Class<T>
        +{abstract} getObj(forceNew, useByteBuddy): Object
        --
        +verifySuperClass()
        +verifyInterfaces()
        +getAttributeWrappers(): List<Wrapper<T>>
        +getMethodsWrappers(): List<Wrapper<T>>
        +getConstructorWrappers(): List<Wrapper<T>>
        --
        +getDynamicSubclassObj(constructorParamTypes, ...): Object
        +testGetter(attribute, getter)
    }

    class GenericClassWrapper<T> {
        -clazz: Class<T>
        --
        +GenericClassWrapper(clz: Class<T>)
        +getClazz(): Class<T>
        +getObj(forceNew, useByteBuddy): Object
    }
    note right of GenericClassWrapper
        Wrapper for existing classes.
        Used for verifying inheritance
        without checking existence.
    end note

    class AttributeWrapper<T,V> {
        -field: Field
        -type: WrapperProperty<Class<?>>
        --
        +AttributeWrapper(parentClass, expectedName, expectedType, ...)
        +getValue(): V
        +getValue(obj: Object): V
        +setValue(value: V)
        +setValue(value: V, obj: Object)
    }

    class MethodWrapper<T,R> {
        -paramTypes: Class<?>[]
        -returnType: WrapperProperty<Class<?>>
        -method: Method
        --
        +MethodWrapper(parentClass, expectedName, expectedReturnType, ...)
        +invoke(params...): R
        +invokeOnSpecificObject(obj, params...): R
    }

    class ConstructorWrapper<T> {
        ~paramTypes: Class<?>[]
        -constructor: Constructor<T>
        --
        +ConstructorWrapper(parentClass, paramTypes, ...)
        +invoke(args...): T
        +getParamTypes(): Class<?>[]
    }

    class StructuralLevenshtein {
        +{static} structuralTestTemplate(wrappers: List)
        +{static} structuralTestFactory(detailsLevel, classWrappers...): List<DynamicTest>
        ..
        <<enum>> DetailLevel
        ONE_FOR_EVERYTHING
        ONE_PER_CLASS
        ONE_PER_MEMBER_CATEGORY
        ONE_PER_MEMBER
    }

    class Utils {
        +{static} levenshteinDistance(s1, s2): int
        +{static} isNameWithinDeviation(expected, actual, threshold): boolean
        +{static} saveCast(val, castTo): Object
        +{static} verifyType(typeWrapperProperty, actualType)
        +{static} canContain(actualType, expectedType): boolean
        +{static} unwrapPrimitive(type): Class<?>
    }

    ' Inheritance relationships
    ClassWrapper --|> Wrapper
    GenericClassWrapper --|> ClassWrapper
    AttributeWrapper --|> Wrapper
    MethodWrapper --|> Wrapper
    ConstructorWrapper --|> Wrapper

    ' Composition relationships
    Wrapper *-- WrapperProperty : name, modifiers
    AttributeWrapper *-- WrapperProperty : type
    MethodWrapper *-- WrapperProperty : returnType
    ClassWrapper *-- WrapperProperty : superClassWrapper,\ninterfaceWrappers

    ' Associations
    Wrapper --> ClassWrapper : parentClassWrapper
    ClassWrapper --> ClassWrapper : superClassWrapper

    ' Layout hints
    WrapperProperty -[hidden]down- Utils
    StructuralLevenshtein -[hidden]down- Utils
}

@enduml